{
  "name": "bellaclaw",
  "module": "src/index.ts",
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@types/bun": "latest",
    "@types/turndown": "^5.0.6",
    "drizzle-kit": "^0.31.10"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "server:down": "podman compose down",
    "server:init": "podman compose up -d --build",
    "server:update": "podman compose build --no-cache && podman compose up -d --force-recreate",
    "start": "bun run src/index.ts",
    "test:prepare": "rm -f test.db && bun --bun drizzle-kit push --config drizzle.test.config.ts",
    "test": "bun run test:prepare && BELLACLAW_DATABASE_MODE=test bun test",
    "db": "bun --bun drizzle-kit"
  },
  "type": "module",
  "dependencies": {
    "@libsql/client": "^0.17.3",
    "@openrouter/sdk": "^0.5.1",
    "discord.js": "^14.25.1",
    "drizzle-orm": "^0.45.2",
    "turndown": "^7.2.4",
    "zod": "^4.3.6"
  }
}
