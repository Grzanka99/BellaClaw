{
  "name": "bellaclaw",
  "module": "src/index.ts",
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@types/bun": "latest",
    "@types/turndown": "^5.0.6",
    "drizzle-kit": "^0.31.10"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "private": true,
  "scripts": {
    "auth:seed-local": "bun run scripts/seed-auth.ts",
    "dev": "bun run auth:seed-local && bun run --watch src/index.ts",
    "server:down": "podman compose --profile signal down",
    "server:init": "bun run auth:seed-local && podman compose --profile signal build && podman compose --profile signal up -d",
    "server:reset-auth": "bun run scripts/seed-auth.ts --reset",
    "server:update": "bun run auth:seed-local && podman compose --profile signal build --no-cache && podman compose --profile signal up -d --force-recreate",
    "start": "bun run src/index.ts",
    "logs:ui": "bun run src/apps/log-viewer/index.ts",
    "logs:turn": "bun run scripts/logs-turn.ts",
    "test": "bun test",
    "db": "bun --bun drizzle-kit"
  },
  "type": "module",
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.81.1",
    "@earendil-works/pi-ai": "0.81.1",
    "@googleworkspace/cli": "0.22.5",
    "@libsql/client": "^0.17.3",
    "croner": "^10.0.1",
    "discord.js": "^14.25.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.30",
    "htmx.org": "^2.0.10",
    "rrule": "2.8.1",
    "turndown": "^7.2.4",
    "zod": "^4.3.6"
  },
  "trustedDependencies": [
    "@googleworkspace/cli"
  ]
}
