# Required for the default Discord + OpenCode Go setup
DISCORD_TOKEN=
OPENCODE_API_KEY=
TURSO_CONNECTION_URL=
TURSO_AUTH_TOKEN=

# Optional AI providers and web search
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
TAVILY_API_KEY=

# Optional Google Calendar integration
BELLACLAW_GOOGLE_CALENDAR_WRITE_ID=

# Optional Signal integration
SIGNAL_ENABLED=false
SIGNAL_PHONE_NUMBER=
SIGNAL_CLI_RPC_URL=http://127.0.0.1:8080

# Optional AI credential and behavior-log paths
BELLACLAW_AI_CREDENTIALS_PATH=
BELLACLAW_LOG_DB_PATH=
BELLACLAW_LOG_VIEWER_HOSTNAME=127.0.0.1
LOG_CHATID_HMAC_KEY=
