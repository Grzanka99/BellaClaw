# Required for the default Discord + OpenCode Go setup
DISCORD_TOKEN=
TURSO_CONNECTION_URL=
TURSO_AUTH_TOKEN=

# Optional activation gate; blank disables it
BELLACLAW_ACTIVATION_TOKEN=

# Optional daily self-update from main in the Compose deployment; see docs/deployment.md#self-update
BELLACLAW_AUTO_UPDATE=false

# Optional AI providers and web search
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
BELLACLAW_EMBEDDING_BASE_URL=http://localhost:11434
# Blank uses EmbeddingGemma 2. Changing it requires a rebuild; see docs/configuration.md#embeddings.
BELLACLAW_EMBEDDING_MODEL=
TAVILY_API_KEY=

# Optional Signal integration
SIGNAL_ENABLED=false
SIGNAL_PHONE_NUMBER=
SIGNAL_CLI_RPC_URL=http://127.0.0.1:8080

# Optional AI credential and behavior-log paths
BELLACLAW_AI_CREDENTIALS_PATH=
BELLACLAW_LOG_DB_PATH=
BELLACLAW_LOG_VIEWER_HOSTNAME=127.0.0.1
LOG_CHATID_HMAC_KEY=

# Connectors (MCP servers) and optional per-chat OAuth or tokens; connectors.json includes the logs and vault connectors.
BELLACLAW_CONNECTORS_CONFIG=./connectors.json
BELLACLAW_LOGS_MCP_URL=
BELLACLAW_VAULT_MCP_URL=http://host.containers.internal:8787/mcp
BELLACLAW_MCP_CREDENTIALS_PATH=
BELLACLAW_MCP_PUBLIC_URL=
BELLACLAW_MCP_AUTH_PORT=3080

# Optional gateway; blank public URL or secret disables it. Generate the secret with: openssl rand -base64 32
BELLACLAW_GATEWAY_PUBLIC_URL=
BELLACLAW_GATEWAY_SECRET=
BELLACLAW_GATEWAY_HOSTNAME=127.0.0.1
BELLACLAW_GATEWAY_PORT=8988
BELLACLAW_GATEWAY_DB_PATH=
BELLACLAW_INTERNAL_API_HOSTNAME=127.0.0.1
BELLACLAW_INTERNAL_API_PORT=3081
BELLACLAW_INTERNAL_API_URL=http://127.0.0.1:3081
# Where the assistant keeps images uploaded from the app; blank uses .data/app-media
BELLACLAW_APP_MEDIA_DIR=
# Optional push to the app: the Firebase service-account JSON key, read by the assistant only.
# Blank, or no file there, turns push off. Compose sets /app/.secrets/fcm-service-account.json
BELLACLAW_FCM_CREDENTIALS_PATH=
# Where FCM is reached; blank uses https://fcm.googleapis.com
BELLACLAW_FCM_URL=
