<?xml version="1.0" encoding="utf-8"?>
<!-- The session (server, token, username) and its file being written never leave the device.
     Nor does the push auth secret: a restored phone makes new push keys and registers again. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="session.json" />
        <exclude domain="file" path="session.json.tmp" />
        <exclude domain="file" path="push_auth_secret" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="session.json" />
        <exclude domain="file" path="session.json.tmp" />
        <exclude domain="file" path="push_auth_secret" />
    </device-transfer>
</data-extraction-rules>
