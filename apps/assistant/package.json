{
  "name": "@bellaclaw/assistant",
  "private": true,
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "auth:generate-token": "bun --env-file=../../.env run scripts/generate-auth-token.ts",
    "check": "bunx @biomejs/biome check .",
    "dev": "bun --env-file=../../.env run --watch src/index.ts",
    "events:redrive": "bun --env-file=../../.env run scripts/redrive-events.ts",
    "embeddings:rebuild": "bun --env-file=../../.env run scripts/rebuild-embeddings.ts",
    "start": "bun --env-file=../../.env run src/index.ts",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit"
  },
  "dependencies": {
    "@bellaclaw/behavior-logs": "workspace:*",
    "@bellaclaw/database": "workspace:*",
    "@bellaclaw/shared": "workspace:*",
    "@earendil-works/pi-agent-core": "1.6.0",
    "@earendil-works/pi-ai": "1.6.0",
    "@earendil-works/pi-schema": "1.6.0",
    "@jitl/quickjs-wasmfile-release-sync": "^0.32.0",
    "@libsql/client": "^0.17.3",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@utcp/http": "1.1.14",
    "@utcp/sdk": "1.2.0",
    "croner": "^10.0.1",
    "discord.js": "^14.25.1",
    "drizzle-orm": "^0.45.2",
    "entities": "^7.0.1",
    "quickjs-emscripten-core": "^0.32.0",
    "rrule": "2.8.1",
    "turndown": "^7.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/turndown": "^5.0.6",
    "drizzle-kit": "^0.31.10"
  }
}
